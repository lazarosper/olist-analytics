model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SnowflakeServer","SnowflakeWarehouse","Order Items","Orders","Customers","Products","Sellers","Date","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Order Items'
ref table Orders
ref table Customers
ref table Products
ref table Sellers
ref table Date
ref table _Measures

ref cultureInfo en-US
